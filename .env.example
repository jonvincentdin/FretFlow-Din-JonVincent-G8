# Django signs sessions with this secret. Generate a unique value for .env.
DJANGO_SECRET_KEY=
# Supabase Connect > Session pooler > URI. URL-encode special password characters.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Your hosted project URL. No Supabase API key is needed for Django authentication.
SUPABASE_URL=
